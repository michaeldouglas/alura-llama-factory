# O repositório mdba/escutia-lora é público; o token é opcional para ele.
# Use um token somente se o repositório for privado ou se o Hugging Face exigir.
HF_TOKEN=
HF_MODEL_ID=mdba/escutia-lora

# Caminho relativo a esta pasta ou caminho absoluto.
MODEL_DIR=modelo

# Origens separadas por vírgula para a integração futura com o site.
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
