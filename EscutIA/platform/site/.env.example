# Google OAuth (Google Cloud Console > Credentials > OAuth client ID)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# NextAuth session secret. Generate a random value; never commit the real one.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Local SQLite database. Prisma resolves this path relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"
