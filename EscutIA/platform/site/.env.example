# Google OAuth (Google Cloud Console > Credentials > OAuth client ID)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# NextAuth session secret. Generate a random value; never commit the real one.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Local SQLite database. Prisma resolves this path relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# The local FastAPI model service is the default provider.
USE_LOCAL_MODEL_API="true"
LOCAL_MODEL_API_URL="http://localhost:8000"

# Only needed when USE_LOCAL_MODEL_API="false". Keep it server-side.
HF_TOKEN=""
HF_MODEL_ID="mdba/escutia-lora"

# Agente EscutIA via Ollama. O modelo é carregado pelo Ollama, não pelo Next.js.
OLLAMA_MODEL="gpt-oss:20b-cloud"
OLLAMA_BASE_URL="http://localhost:11434"

# Checkpoint do grafo para retomadas de confirmação; o histórico das mensagens continua no Prisma/SQLite.
LANGGRAPH_DATABASE_PATH="./prisma/langgraph.db"
