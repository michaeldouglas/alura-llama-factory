{
  "feature_id": "001-resource-efficient-finetune",
  "approved_external_root_template": "%LOCALAPPDATA%/alura-llama-factory/001-resource-efficient-finetune",
  "allowed_versioned_content": [
    "scripts",
    "tests",
    "schemas",
    "source identifiers and hashes",
    "configuration proposals",
    "reports without third-party source text or secrets"
  ],
  "prohibited_in_repository": [
    "credentials and secrets",
    "private or source dataset records",
    "model weights",
    "tokenizer caches",
    "Python environments",
    "download caches",
    "derived training data",
    "checkpoints",
    "raw logs containing source text"
  ],
  "prohibited_extensions": [".safetensors", ".gguf", ".ckpt", ".pt", ".pth"],
  "overwrite_policy": "DENY",
  "fallback_policy": "DENY_REPOSITORY_CPU_WSL_REMOTE_OR_PAID_FALLBACK"
}
